{
  "name": "mastertutor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.4"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"apps/web/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --project unit",
    "test:ui": "pnpm --filter @mastertutor/web test:ui",
    "test:int": "vitest run --project integration",
    "env:init": "node scripts/env-init.ts",
    "compose:test": "docker compose --env-file .env.test -f compose.yml -f compose.test.yml",
    "smoke": "bash scripts/compose-smoke.sh",
    "test:behaviour": "vitest run --project behaviour"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mastertutor/contracts": "workspace:*",
    "@mastertutor/db": "workspace:*",
    "@types/node": "24.19.1",
    "drizzle-orm": "0.45.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
