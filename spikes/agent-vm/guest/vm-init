#!/bin/sh
# P0 adaptation of P1.12 Step 5: no credential-bearing guest.env file.
set -eu
if [ "${1:-}" != stage2 ]; then
  mount -t tmpfs -o size=1536m,mode=0755 rw /mnt/rw
  mkdir -p /mnt/rw/upper /mnt/rw/work /mnt/rw/root
  mount -t overlay overlay -o lowerdir=/,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work /mnt/rw/root
  mkdir -p /mnt/rw/root/.oldroot
  cd /mnt/rw/root
  pivot_root . .oldroot
  exec chroot . /sbin/vm-init stage2
fi
mount -t proc proc /proc
umount -l /.oldroot
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o size=1g,mode=1777 shm /dev/shm
mount -t tmpfs -o mode=0755 run /run
mkdir -p /var/log/neko /var/log/guest /tmp/chromium-profile /run/user/1000
chown neko:neko /var/log/neko /tmp/chromium-profile /run/user/1000
chmod 700 /tmp/chromium-profile /run/user/1000
ip link set lo up
ip addr add 192.168.127.2/30 dev eth0
ip link set eth0 up
ip route add default via 192.168.127.1
export DISPLAY=:99.0 USER=neko XDG_RUNTIME_DIR=/run/user/1000
/usr/bin/X -config /etc/neko/xorg.conf -noreset -nolisten tcp :99 >/var/log/neko/xorg.log 2>&1 &
attempt=0
while [ ! -S /tmp/.X11-unix/X99 ]; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 300 ]; then
    printf 'P0_FAIL Xorg did not create its socket\n'
    tail -n 40 /var/log/neko/xorg.log
    reboot -f
  fi
  sleep 0.05
done
su neko -s /bin/sh -c 'openbox --config-file /etc/neko/openbox.xml' >/var/log/neko/openbox.log 2>&1 &
# The vsock listener is bound BEFORE golden, so restore measures listener survival.
epoch="$(python3 /opt/spike/start_line.py)"
date -s "@$((epoch / 1000))" >/dev/null
. /opt/spike/static-neko.sh
export NEKO_MEMBER_PROVIDER=object NEKO_MEMBER_OBJECT_USERS='[]'
export NEKO_WEBRTC_NAT1TO1=127.0.0.1 NEKO_WEBRTC_UDPMUX=59101 NEKO_WEBRTC_TCPMUX=59101
# Public measurements only: this guest has no credentials and accepts no model commands.
printf 'P0_ID boot_id=%s urandom=%s clock=%s leftover=%s\n' \
  "$(cat /proc/sys/kernel/random/boot_id)" "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')" \
  "$(date +%s)" "$(test -e /home/neko/leftover && echo present || echo absent)"
touch /home/neko/leftover
/usr/bin/supervisord -c /etc/guest/supervisord.conf &
while true; do wait || true; sleep 1; done
