#!/bin/bash
# Browser-slot entrypoint. It:
#   1. derives the n.eko member passwords;
#   2. installs the network filter;
#   3. wipes any previous browser state (never /downloads, see below);
#   4. execs n.eko's supervisord.
set -euo pipefail

for name in SLOT_NAME NEKO_ADMIN_SECRET NEKO_MEMBER_SECRET CDP_ALLOWED_IP PULSE_ALLOWED_IP NEKO_ALLOWED_IPS; do
  if [[ -z "${!name:-}" ]]; then echo "slot-entrypoint: $name is required" >&2; exit 64; fi
done
if [[ ! "$SLOT_NAME" =~ ^browser-[1-9][0-9]?$ ]]; then echo "slot-entrypoint: invalid SLOT_NAME" >&2; exit 64; fi
# Each one IPv4 address or CIDR: they feed iptables and PulseAudio's auth-ip-acl (the behaviour
# stack uses 0.0.0.0/0 for CDP on purpose, so a CIDR must stay accepted). CDP is the agent's; the
# Pulse port is the audio-capture service's alone (B4 review I7).
for name in CDP_ALLOWED_IP PULSE_ALLOWED_IP; do
  if [[ ! "${!name}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$ ]]; then
    echo "slot-entrypoint: invalid $name" >&2
    exit 64
  fi
done
if (( ${#NEKO_ADMIN_SECRET} < 32 || ${#NEKO_MEMBER_SECRET} < 32 )); then
  echo "slot-entrypoint: n.eko secrets must be at least 32 characters" >&2; exit 64
fi

# SLOT_EGRESS_ALLOW_CIDRS entries must be private IPv4 CIDRs no wider than /16 (never 0.0.0.0/0).
validate_allow_cidr() {
  local cidr="$1" a b c d prefix
  if [[ ! "$cidr" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,2})$ ]]; then return 1; fi
  a=$((10#${BASH_REMATCH[1]})); b=$((10#${BASH_REMATCH[2]})); c=$((10#${BASH_REMATCH[3]})); d=$((10#${BASH_REMATCH[4]}))
  prefix=$((10#${BASH_REMATCH[5]}))
  (( a <= 255 && b <= 255 && c <= 255 && d <= 255 && prefix >= 16 && prefix <= 32 )) || return 1
  (( a == 10 )) && return 0
  (( a == 172 && b >= 16 && b <= 31 )) && return 0
  (( a == 192 && b == 168 )) && return 0
  return 1
}
if [[ -n "${SLOT_EGRESS_ALLOW_CIDRS:-}" ]]; then
  IFS=',' read -r -a egress_allowed <<< "$SLOT_EGRESS_ALLOW_CIDRS"
  for cidr in "${egress_allowed[@]}"; do
    validate_allow_cidr "$cidr" || { echo "slot-entrypoint: SLOT_EGRESS_ALLOW_CIDRS entries must be private IPv4 CIDRs with prefix >= /16" >&2; exit 64; }
  done
fi
for mux in "${NEKO_WEBRTC_UDPMUX:-}" "${NEKO_WEBRTC_TCPMUX:-}"; do
  if [[ -n "$mux" && ! "$mux" =~ ^[0-9]{1,5}$ ]]; then echo "slot-entrypoint: invalid WebRTC mux port" >&2; exit 64; fi
done

# Same derivation as deriveNekoPassword() in @mastertutor/contracts/server.
hmac_hex() { printf '%s' "$SLOT_NAME" | openssl dgst -sha256 -hmac "$1" -r | cut -d' ' -f1; }
admin_password="$(hmac_hex "$NEKO_ADMIN_SECRET")"
user_password="$(hmac_hex "$NEKO_MEMBER_SECRET")"
unset NEKO_ADMIN_SECRET NEKO_MEMBER_SECRET

profile() { # name is_admin can_host can_share_media can_access_clipboard
  printf '{"name":"%s","is_admin":%s,"can_login":true,"can_connect":true,"can_watch":true,"can_host":%s,"can_share_media":%s,"can_access_clipboard":%s,"sends_inactive_cursor":false,"can_see_inactive_cursors":false}' \
    "$1" "$2" "$3" "$4" "$5"
}
export NEKO_MEMBER_PROVIDER=object
# The user member boots WITHOUT hosting or clipboard rights (spec §10.3 control lock): only the
# agent's LiveView.giveControl grants can_host, and only while runs.controller = 'user'.
NEKO_MEMBER_OBJECT_USERS="[{\"username\":\"agent\",\"password\":\"${admin_password}\",\"profile\":$(profile agent true true true true)},{\"username\":\"user\",\"password\":\"${user_password}\",\"profile\":$(profile user false false false false)}]"
export NEKO_MEMBER_OBJECT_USERS
unset admin_password user_password

# IPv6 is off in the slot. Preferred: the disable_ipv6 sysctl (Compose `sysctls` sets it, or we
# write it with NET_ADMIN). Fallback: ip6tables default-DROP, loopback only. Neither works: exit.
ipv6_disabled() {
  [[ ! -e /proc/sys/net/ipv6/conf/all/disable_ipv6 ]] \
    || [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" == "1" ]]
}
if ! ipv6_disabled; then
  { echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6 && echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6; } 2>/dev/null || true
fi
if ! ipv6_disabled; then
  {
    ip6tables -F INPUT && ip6tables -F OUTPUT && ip6tables -F FORWARD \
      && ip6tables -A INPUT -i lo -j ACCEPT && ip6tables -A OUTPUT -o lo -j ACCEPT \
      && ip6tables -P INPUT DROP && ip6tables -P OUTPUT DROP && ip6tables -P FORWARD DROP
  } || { echo "slot-entrypoint: cannot disable or filter IPv6" >&2; exit 70; }
fi

# Ingress is default-DROP. Allowed: loopback, replies, n.eko (8080) from agent/web/Traefik, CDP (9223),
# the X idle probe (9224) from the agent, PulseAudio (4713) from audio-capture, and the WebRTC mux
# port when configured.
iptables -F INPUT
iptables -F OUTPUT
iptables -P INPUT DROP
iptables -A INPUT -i lo -j ACCEPT
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
for port in 9223 9224; do
  iptables -A INPUT -p tcp --dport "$port" -s "$CDP_ALLOWED_IP" -j ACCEPT
done
iptables -A INPUT -p tcp --dport 4713 -s "$PULSE_ALLOWED_IP" -j ACCEPT
IFS=',' read -r -a neko_ips <<< "$NEKO_ALLOWED_IPS"
for ip in "${neko_ips[@]}"; do iptables -A INPUT -p tcp --dport 8080 -s "$ip" -j ACCEPT; done
if [[ -n "${NEKO_WEBRTC_UDPMUX:-}" ]]; then iptables -A INPUT -p udp --dport "$NEKO_WEBRTC_UDPMUX" -j ACCEPT; fi
if [[ -n "${NEKO_WEBRTC_TCPMUX:-}" ]]; then iptables -A INPUT -p tcp --dport "$NEKO_WEBRTC_TCPMUX" -j ACCEPT; fi

# Egress: the browser may reach the internet but never private or special-use ranges (other
# slots, web, the metadata address). Replies to inbound connections are allowed by conntrack.
iptables -A OUTPUT -o lo -j ACCEPT
iptables -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
if [[ -n "${SLOT_EGRESS_ALLOW_CIDRS:-}" ]]; then
  for cidr in "${egress_allowed[@]}"; do iptables -A OUTPUT -d "$cidr" -j ACCEPT; done
fi
for cidr in 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 \
  192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4; do
  iptables -A OUTPUT -d "$cidr" -j REJECT
done

# Compose restarts the same container, so wipe every previous-run trace: the profile,
# the home-directory state Chromium writes outside the profile, and stray /tmp entries.
# /downloads is deliberately NOT wiped: that volume is shared by every slot and the agent, so a
# wipe here would delete other slots' in-flight downloads. The agent deletes /downloads/<runId>
# when a run is released.
mkdir -p /tmp/chromium-profile /downloads /home/neko
find /tmp/chromium-profile -mindepth 1 -delete
rm -rf /home/neko/Downloads /home/neko/.pki /home/neko/.cache /home/neko/.config
find /tmp -mindepth 1 -maxdepth 1 ! -name chromium-profile -exec rm -rf {} +
chown neko:neko /tmp/chromium-profile /downloads
chmod 700 /tmp/chromium-profile

# PulseAudio TCP for the audio-capture service (spec §8 transcribe). Module loading is disallowed
# at runtime, so the module goes into default.pa before supervisord starts PulseAudio. The ACL is
# the same address or CIDR the iptables rule admits (validated above).
{ cat /etc/pulse/default.pa.orig; echo "load-module module-native-protocol-tcp port=4713 listen=0.0.0.0 auth-ip-acl=${PULSE_ALLOWED_IP}"; } > /etc/pulse/default.pa

exec "$@"
